        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:pathData="M3,12a9,9 0,1 0,18 0a9,9 0,1 0,-18 0z" />
    <!-- centre patch -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,8.4L15.42,10.89L14.12,14.91L9.88,14.91L8.58,10.89z" />
